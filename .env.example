# Django Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
# 1 = activé (développement) / 0 = désactivé (production)
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=EneoNewsletter.settings
# Domaine utilisé pour construire les liens (désabonnement, emails)
DOMAIN=localhost:10000

# Database (PostgreSQL externe - URL du service Dokploy)
# Coller l'URL de connexion fournie par Dokploy, ex :
#   postgresql://user:password@dokploy-host:5432/eneonewsletter
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (externe - URL du service Dokploy ; utiliser rediss:// pour TLS)
# Celery réutilise REDIS_URL (voir settings.py)
REDIS_URL=redis://host:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@eneo.cm

# Localization
TIME_ZONE=Africa/Douala
LANGUAGE_CODE=fr-fr

# Gunicorn Configuration (production/Render uniquement)
WEB_CONCURRENCY=2

# Celery : utilise REDIS_URL (voir settings.py)
